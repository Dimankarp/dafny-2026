// Задача 4: Sqrt2. 3 балла.
// Напишите метод, реализующий более эффективное вычисление корня из натурального числа.
// Для этого заполните "дырки" в текущей реализации, исправив TODO
// Может быть полезно выписать Хоаровы тройки, чтобы понять, какие именно выражения требуется вписать
method Sqrt2(N: nat) returns (r: nat)
  ensures r * r <= N < (r + 1) * (r + 1)
{
  r := 0;
  var s := 1;
  while s <= N
    invariant r*r <= N
    invariant s == (r + 1) * (r + 1)
  {
    s := s + 2*r+3;
    r := r + 1;
  }
}
